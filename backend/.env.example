# ---- Narcos Tacos POS — Environment Variables ----
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# Postgres connection string
DATABASE_URL=postgresql://narcos:narcos_dev@localhost:5432/narcos_tacos

# Server port
PORT=4000

# Signs the Back Office session cookie (JWT) and the "awaiting 2FA"/"2FA
# setup" temp tokens. Any long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Signs the device-pairing cookie (JWT) that marks an Order Entry/KDS
# device as paired. Deliberately a SEPARATE secret from SESSION_SECRET —
# device trust and staff session trust are orthogonal layers, so a leak
# of one shouldn't compromise the other. Generate the same way:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DEVICE_SECRET=

# Resend API key (transactional email — Back Office forgot-password links).
# narcostacos.ca is already verified with Resend; do not hardcode this key
# or log it anywhere.
RESEND_API_KEY=

# Base URL of the frontend, used to build the reset-password link emailed
# to owners/admins. No trailing slash.
FRONTEND_URL=http://localhost:5173

# HST/GST registration number printed on customer receipts. Optional — the
# receipt simply omits the line when this is unset. This is a STOPGAP: the
# number belongs on locations.hst_number so a second store can carry its own,
# which needs a migration. Until then, one number for one store.
BUSINESS_TAX_NUMBER=

# ---- Stripe Terminal ----
# See docs/architecture/stripe-terminal-plan.md.
#
# The kill-switch. 'mock' (the default, and what you get by leaving this
# unset) keeps today's mocked Cash/Card path — no Stripe call is ever made.
# 'stripe' turns on real card-present payments AND makes the three vars
# below mandatory: any one of them missing throws at boot rather than
# failing in front of a customer. An unrecognised value is a hard error,
# never a silent fall back to 'mock'.
PAYMENTS_PROVIDER=mock

# Stripe secret key — sk_test_… while testing, sk_live_… in production.
# Backend only: this must never reach the frontend bundle or git. Safe to
# set while PAYMENTS_PROVIDER=mock — it changes no payment behaviour, and
# it is what lets Back Office → Stripe diagnostics prove connectivity
# before the switch is flipped.
STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook endpoint (whsec_…), from the
# Stripe Dashboard. Required when PAYMENTS_PROVIDER=stripe. No webhook
# route exists yet — that arrives with Slice 2.
STRIPE_WEBHOOK_SECRET=

# Pinned Stripe API version. Terminal endpoints are version-sensitive, so
# this is pinned deliberately and never left to float. Leave blank in mock
# mode and the SDK's own bundled version is used; PAYMENTS_PROVIDER=stripe
# requires it to be set explicitly, so the pin is visible and reviewable
# in the environment rather than defaulted in code.
STRIPE_API_VERSION=2026-07-29.dahlia

# ---- Reconciliation sweep (the safety net behind the webhooks) ----
# See docs/architecture/stripe-go-live.md.
#
# How often the background sweep runs, in minutes. DEFAULTS TO 0, WHICH
# MEANS IT NEVER RUNS — deliberate, so nothing sweeps unattended until
# someone decides it should, but it MUST be set before go-live. Without
# it, a webhook Stripe never manages to deliver leaves a customer paid up
# with no order and nobody cooking. 5 is a sensible production value.
# Ignored entirely while Stripe is unconfigured.
RECONCILE_INTERVAL_MINUTES=0

# How old (minutes) an 'awaiting_payment' checkout must be before the
# sweep asks Stripe what really happened to it. Long enough that a
# customer still choosing a tip is never swept out from under. 20 is the
# default if unset; set it explicitly in production so it is visible.
RECONCILE_STALE_MINUTES=20

# ---- Owner-role escape hatch ----
# The `owner` role can only be CREATED or ASSIGNED by one designated account.
# Everyone else — including other owners — is blocked in the Staff Management
# UI and rejected by the API. Existing owners are untouched and stay fully
# editable (name, email, hourly rate, PIN reset, activate/deactivate).
#
# Set ONE of these. Leaving BOTH unset fails closed: nobody can assign the
# owner role at all (the server logs a warning at boot).
#
# Preferred — a staff row's id can never be changed through any API, so the
# designation cannot be moved by another owner. Find it with:
#   SELECT id, name, email FROM staff WHERE role = 'owner';
SUPER_OWNER_STAFF_ID=

# Convenience alternative, matched case-insensitively against staff.email.
# Safe because PUT /api/backoffice/staff/:id refuses to let anyone other than
# the super-owner change the super-owner's email or role.
SUPER_OWNER_EMAIL=
